rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'PASTE_ADMIN_UID'; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    // Shared booking/event data only. Never store payment fields here.
    match /bookings/{bookingId} {
      allow read: if isOwner() || isStaff();
      allow create, update: if isOwner() || isStaff();
      allow delete: if isOwner();
    }
    // Financial data is isolated; only the owner can access it.
    match /bookingPayments/{bookingId} {
      allow read, write: if isOwner();
    }
    // Staff account marker; owner creates these documents in Firebase Console.
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
